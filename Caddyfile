:3000 {
    root * /srv
    encode gzip zstd

    # adapter-static emits flat files — /symptoms/hot-flashes.html, and
    # /symptoms.html *beside* a /symptoms/ directory that has no index.html.
    # Without this, every extensionless URL 404s: the directory match wins for
    # /symptoms and nothing matches at all for /symptoms/hot-flashes. Browsing
    # the site hides it, because SvelteKit routes client-side after hydration —
    # only direct hits, shared links, and crawlers ever ask the server.
    # .html must be tried before the bare path so /symptoms.html beats /symptoms/.
    try_files {path}.html {path} {path}/index.html

    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle_errors {
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
